# ── Required ──────────────────────────────────────────────────────────────────
# Tavily API key — get one at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# LLM provider: "anthropic", "openai", or "gemini"
LLM_PROVIDER=gemini

# Google / Gemini API key — required when LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Anthropic API key — required when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key — required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional / tunable ────────────────────────────────────────────────────────
# Model name (must match the provider above)
LLM_MODEL=gemini-2.5-flash

# Maximum search results per query (1–20)
MAX_SEARCH_RESULTS=10

# SQLite database file path (relative to project root)
DATABASE_PATH=data/prospects.db

# Path to the evaluation dataset (JSON Lines)
EVAL_DATASET_PATH=data/eval_dataset.jsonl

# Request timeout in seconds for external API calls
REQUEST_TIMEOUT_SECONDS=30

# Maximum retry attempts for transient failures
MAX_RETRIES=3
